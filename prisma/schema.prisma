// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

// Relation ajoutée : historique des essais de test de l'utilisateur
  quizAttempts  QuizAttempt[]
  contactMessages ContactMessage[]
role String?
	banned Boolean?
	banReason String?
	banExpires DateTime? @db.Timestamptz(3)


  // Un utilisateur a au plus UN abonnement actif à la fois, mais peut
  // avoir plusieurs paiements dans son historique (renouvellements).
  subscription  Subscription?
  payments      Payment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

/// Un essai de test complet effectué par un utilisateur pour un permis donné.
model QuizAttempt {
  id             String   @id @default(cuid())

  // Lien vers l'utilisateur (suppression en cascade si le compte est supprimé)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identifie le permis concerné (ex: "b", "a1"...)
  permisSlug     String
  permisCode     String

  // Résultat de l'essai
  score          Int      // nombre de bonnes réponses
  totalQuestions Int      // nombre total de questions posées
  passed         Boolean  // true si le seuil de réussite (80%) était atteint

  createdAt      DateTime @default(now())

  // Index pour accélérer les requêtes "essais d'un utilisateur, du plus récent au plus ancien"
  @@index([userId, createdAt])
  @@map("quiz_attempt")
}

/// État d'abonnement premium de l'utilisateur. Une seule ligne par
/// utilisateur : on la met à jour à chaque paiement réussi plutôt que
/// d'en créer une nouvelle (l'historique des transactions vit dans Payment).
model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(EXPIRED)
  startedAt DateTime?
  expiresAt DateTime?
  updatedAt DateTime           @updatedAt

  @@map("subscription")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

/// Trace chaque tentative de paiement Kkiapay, réussie ou non — utile
/// pour le support client et pour éviter de traiter deux fois le même
/// webhook (idempotence via kkiapayTransactionId, unique).
model Payment {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kkiapayTransactionId String        @unique
  amount               Int
  status               PaymentStatus @default(PENDING)
  method                String?      // "mobile_money", "card"... renvoyé par Kkiapay
  createdAt            DateTime      @default(now())

  @@index([userId])
  @@map("payment")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum QuestionDifficulty {
  FACILE
  MOYEN
  DIFFICILE
}

model LicenseType {
  id          String   @id @default(cuid())
  code        String   @unique // Ex: "A", "B", "C", "D"
  name        String   // Ex: "Permis A - Moto"
  description String?  @db.Text
  imageUrl    String?
  minAge      Int?
  isActive    Boolean  @default(true)
  order       Int      @default(0)

  courses     Course[]
  tests       Test[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("license_types")
}

model Course {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String?     @db.Text
  coverImageUrl String?
  order         Int         @default(0)
  isPublished   Boolean     @default(false)

  licenseTypeId String
  licenseType   LicenseType @relation(fields: [licenseTypeId], references: [id], onDelete: Cascade)

  lessons       Lesson[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([licenseTypeId])
  @@map("courses")
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text // HTML généré par l'éditeur riche
  order       Int      @default(0)
  duration    Int?     // durée estimée en minutes
  isPublished Boolean  @default(true)

  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@map("lessons")
}

model Test {
  id            String      @id @default(cuid())
  title         String
  description   String?     @db.Text
  durationMin   Int         @default(20)
  passingScore  Int         @default(80) // en pourcentage
  isPublished   Boolean     @default(false)

  licenseTypeId String
  licenseType   LicenseType @relation(fields: [licenseTypeId], references: [id], onDelete: Cascade)

  questions     Question[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([licenseTypeId])
  @@map("tests")
}

model Question {
  id          String             @id @default(cuid())
  text        String             @db.Text
  imageUrl    String?
  explanation String?            @db.Text
  difficulty  QuestionDifficulty @default(MOYEN)
  order       Int                @default(0)

  testId      String
  test        Test               @relation(fields: [testId], references: [id], onDelete: Cascade)

  options     QuestionOption[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([testId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("messages")
}

model SiteSettings {
  id          String   @id @default("main")
  siteName    String
  title       String
  description String
  keywords    String?
  logoUrl     String?
  faviconUrl  String?
  ogImageUrl  String?
  updatedAt   DateTime @updatedAt
}